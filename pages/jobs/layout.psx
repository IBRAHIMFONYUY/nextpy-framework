"""
JobHub - Root layout. Wraps all /jobs pages with nav + footer.
Resolves the authenticated user during SSR so the nav matches the page state.
"""

from nextpy.psx import component, Link, psx
from nextpy.db import get_session, User
from nextpy.auth import get_user_id_from_request
import html as _html


@component
def Layout(children, **props):
    props = props or {}
    request = props.get("request") or props.get("req")
    user = None
    user_id = get_user_id_from_request(request) if request else None
    if user_id is not None:
        db = get_session()
        try:
            account = db.query(User).filter(User.id == user_id).first()
            if account is not None:
                user = {
                    "full_name": account.full_name or "",
                    "username": account.username or "",
                }
        finally:
            db.close()

    if user:
        display_name = _html.escape(user.get("full_name") or user.get("username") or "")
        auth_section = psx(
            '<span class="text-sm text-gray-600">Hi, '
            + display_name
            + '</span><a href="/jobs/logout" class="px-3 py-2 text-sm font-medium text-red-600 rounded-md hover:bg-red-50">Logout</a>'
        )
    else:
        auth_section = psx(
            '<a href="/jobs/login" class="px-4 py-2 text-sm font-medium text-gray-700 rounded-md hover:bg-gray-100">Log in</a>'
            '<a href="/jobs/register" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700">Sign up</a>'
        )

    return (
        <html lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>JobHub</title>
                <link href="/tailwind.css" rel="stylesheet" />
            </head>
            <body class="min-h-screen bg-gray-50">
                <nav class="sticky top-0 z-40 border-b border-gray-200 bg-white/80 backdrop-blur-md">
                    <div class="flex items-center justify-between px-4 py-3 mx-auto max-w-7xl sm:px-6 lg:px-8">
                        <Link href="/jobs" class="flex items-center gap-2 text-xl font-bold text-indigo-600">
                            JobHub
                        </Link>
                        <div class="items-center hidden gap-6 text-sm font-medium text-gray-700 sm:flex">
                            <a href="/jobs" class="hover:text-indigo-600">Browse Jobs</a>
                            <a href="/jobs/dashboard" class="hover:text-indigo-600">Dashboard</a>
                        </div>
                        <div class="flex items-center gap-3">
                            {auth_section}
                        </div>
                    </div>
                </nav>
                <main class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
                    {children}
                </main>
                <footer class="mt-16 bg-white border-t border-gray-200">
                    <div class="px-4 py-8 mx-auto text-sm text-center text-gray-500 max-w-7xl">
                        Built with NextPyVision - JobHub
                    </div>
                </footer>
            </body>
        </html>
    )


def getServerSideProps(context):
    return {"props": {}}


