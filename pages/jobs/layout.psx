"""
JobHub - Root layout. Wraps all /jobs pages with nav + footer.
Uses useFetch to call get_me server action for auth state.
"""

from nextpy.psx import component, useFetch, Link
from nextpy.db import get_session, User
from nextpy.auth import get_user_id_from_request


@component
def Layout(children, **props):
    props=props or {}
    
    me = useFetch("/__nextpy/actions/execute", {
        "method": "POST",
        "headers": {"Content-Type": "application/json", "Accept": "application/json"},
        "body": '{"action":"get_me","params":{}}',
    })
    me_key = me["_dataKey"]
    user_data = me.get("data", {})
    user = user_data.get("user") if isinstance(user_data, dict) else None

    return (
        <html lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>JobHub</title>
                <link href="/tailwind.css" rel="stylesheet" />
            </head>
            <body class="min-h-screen bg-gray-50">
                <nav class="sticky top-0 z-40 border-b border-gray-200 bg-white/80 backdrop-blur-md">
                    <div class="flex items-center justify-between px-4 py-3 mx-auto max-w-7xl sm:px-6 lg:px-8">
                        <Link href="/jobs" class="flex items-center gap-2 text-xl font-bold text-indigo-600">
                            JobHub
                        </Link>
                        <div class="items-center hidden gap-6 text-sm font-medium text-gray-700 sm:flex">
                            <a href="/jobs" class="hover:text-indigo-600">Browse Jobs</a>
                            <a href="/jobs/dashboard" class="hover:text-indigo-600">Dashboard</a>
                        </div>
                        <div class="flex items-center gap-3">
                            {if user:
                                <span class="text-sm text-gray-600">Hi, {user.get("full_name", user.get("username", ""))}</span>
                            }
                            {if user:
                                <a href="/jobs/logout" class="px-3 py-2 text-sm font-medium text-red-600 rounded-md hover:bg-red-50">
                                    Logout
                                </a>
                            }
                            {if not user:
                                <a href="/jobs/login" class="px-4 py-2 text-sm font-medium text-gray-700 rounded-md hover:bg-gray-100">
                                    Log in
                                </a>
                            }
                            {if not user:
                                <a href="/jobs/register" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700">
                                    Sign up
                                </a>
                            }
                        </div>
                    </div>
                </nav>
                <main class="px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8">
                    {children}
                </main>
                <footer class="mt-16 bg-white border-t border-gray-200">
                    <div class="px-4 py-8 mx-auto text-sm text-center text-gray-500 max-w-7xl">
                        Built with NextPyVision - JobHub
                    </div>
                </footer>
            </body>
        </html>
    )


def getServerSideProps(context):
    return {"props": {}}


