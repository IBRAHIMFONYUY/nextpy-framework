from nextpy.psx import component, register_component, Link
from pages.documentation._components.enhanced_sidebar import EnhancedSidebar

register_component("EnhancedSidebar", EnhancedSidebar)

@component
def Layout(children, **props):
    return (
        <html>
            <head>
                <title>{props.get('title', 'NextPy Docs- The Python Web Framework')}</title>
                <link rel="shortcut icon" href="/static/images/icon.png" type="image/x-icon" />
                <link href="/static/styles.css" rel="stylesheet" />
                <link href="/tailwind.css" rel="stylesheet" />
                <link href="/static/css/docs.css?v=2" rel="stylesheet" />
            </head>
            <body class="bg-[#000000] text-[#eddde3] antialiased selection:bg-blue-500/30 selection:text-blue-200">
                <div class="flex flex-col w-full min-h-screen scroll-smooth">
                    
                    {/* Modern Top Header / Navbar */}
                    <header class="sticky top-0 z-50 w-full border-b border-zinc-800/50 bg-black/70 backdrop-blur-md">
                        <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-4 sm:px-6 lg:px-8">
                            <div class="flex items-center gap-8">
                                <Link href="/" class="flex items-center gap-2 font-bold tracking-tight text-white hover:opacity-90">
                                    <span class="text-lg text-transparent bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text">Next.py</span>
                                    <span class="text-xs font-medium px-2 py-0.5 rounded border border-zinc-800 bg-zinc-900 text-zinc-400">Docs</span>
                                </Link>
                                <nav class="hidden md:flex items-center gap-6 text-[15px] font-medium text-zinc-400">
                                    <Link href="/docs" class="text-white">Documentation</Link>
                                    <Link href="/components-showcase" class="transition-colors hover:text-zinc-200">Showcase</Link>
                                    <Link href="/blog" class="transition-colors hover:text-zinc-200">Blog</Link>
                                </nav>
                            </div>
                            
                            <div class="flex items-center gap-4">
                            <!-- Search Bar -->
                            <div class="relative hidden w-56 sm:block md:w-72">
                                <div class="absolute inset-y-0 flex items-center pointer-events-none left-3 text-zinc-500">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                                <input type="text" placeholder="Search docs..." disabled class="w-full py-2 pl-10 pr-4 text-sm border rounded-md cursor-not-allowed border-zinc-800 bg-zinc-900/50 text-zinc-400 placeholder-zinc-500 focus:outline-none" />
                                <div class="absolute inset-y-0 flex items-center right-3">
                                    <kbd class="rounded border border-zinc-700 bg-zinc-800 px-1.5 text-[11px] font-sans text-zinc-400">⌘K</kbd>
                                </div>
                            </div>
                            
                            <!-- GitHub Link with SVG -->
                            <div>
                                <Link href="https://github.com/RAHIMSTUDIOS/nextpy-framework" target="_blank" rel="noopener noreferrer" className="transition-colors duration-200 text-zinc-400 hover:text-zinc-100" aria-label="GitHub Repository">
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                                    </svg>
                                </Link>
                            </div>
                        </div>

                        </div>
                    </header>

                    {/* Main Layout Grid Container */}
                    <div class="flex-1 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
                        {/* REMOVED items-start so the sidebar stretches to full height */}
                        <div class="flex justify-between gap-8">
                            
                            {/* 1. Left Sidebar Navigation Area (Fixed Width) */}
                            <aside class="hidden lg:block w-[280px] shrink-0 border-r border-zinc-800/50">
                                <div class="sticky top-16 h-[calc(100vh-4rem)] py-12 pr-6 overflow-y-auto scrollbar-none">
                                    <EnhancedSidebar />
                                </div>
                            </aside>

                            {/* 2. Main Content Area (Children handle their own max-w constraints) */}
                            <main class="flex-1 min-w-0 py-10">
                                {children}
                            </main>

                        </div>
                    </div>
                </div>
            </body>
        </html>
    )