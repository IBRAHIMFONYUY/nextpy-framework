from nextpy.psx import component, register_component, Link
from pages.documentation._components.github_stats import get_github_stars, format_stars
from pages.documentation._components.enhanced_sidebar import EnhancedSidebar
from pages.documentation._components.docscroll import DocsScrollSpy

register_component("EnhancedSidebar", EnhancedSidebar)
register_component("DocsScrollSpy", DocsScrollSpy)

@component
def Layout(children, **props):
    star_count = format_stars(get_github_stars())
    return (
        <html>
            <head>
                <title>{props.get('title', 'NextPy Docs- The Python Web Framework')}</title>
                <link rel="shortcut icon" href="/static/images/icon.png" type="image/x-icon" />
                <link href="/static/styles.css" rel="stylesheet" />
                <link href="/tailwind.css" rel="stylesheet" />
                <link href="/static/css/docs.css?v=3" rel="stylesheet" />
            </head>
            <body class="bg-[#000000] text-[#eddde3] antialiased selection:bg-blue-500/30 selection:text-blue-200">
                <DocsScrollSpy />
                <div class="flex flex-col w-full min-h-screen scroll-smooth">
                    
                    {/* Modern Top Header / Navbar */}
                    <header class="sticky top-0 z-50 w-full border-b border-zinc-800/50 bg-black/70 backdrop-blur-md">
                        <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-4 sm:px-6 lg:px-8">
                            <div class="flex items-center gap-8">
                                <Link href="/" class="flex items-center gap-2 font-bold tracking-tight text-white hover:opacity-90">
                                    <span class="text-lg font-bold text-white">NextPy</span>
                                    <span class="text-xs font-medium px-2 py-0.5 rounded border border-zinc-800 bg-zinc-900 text-zinc-400">v5.1.4</span>
                                </Link>
                                <nav class="hidden md:flex items-center gap-6 text-[15px] font-medium text-zinc-400">
                                    <Link href="/documentation" class="text-white">Learn</Link>
                                    <Link href="/templates" class="transition-colors hover:text-zinc-200">Templates</Link>
                                    <Link href="/components-showcase" class="transition-colors hover:text-zinc-200">Showcase</Link>
                                    <Link href="/blog" class="transition-colors hover:text-zinc-200">Blog</Link>
                                    <Link href="https://github.com/RAHIMSTUDIOS/nextpy-framework/discussions" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-200">Community</Link>
                                </nav>
                            </div>
                            
                            <div class="flex items-center gap-4">
                            <!-- Search Bar -->
                            <div class="relative hidden w-56 sm:block md:w-72">
                                <div class="absolute inset-y-0 flex items-center pointer-events-none left-3 text-zinc-500">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                                <input type="text" placeholder="Search docs..." disabled class="w-full py-2 pl-10 pr-4 text-sm border rounded-md cursor-not-allowed border-zinc-800 bg-zinc-900/50 text-zinc-400 placeholder-zinc-500 focus:outline-none" />
                                <div class="absolute inset-y-0 flex items-center right-3">
                                    <kbd class="rounded border border-zinc-700 bg-zinc-800 px-1.5 text-[11px] font-sans text-zinc-400">⌘K</kbd>
                                </div>
                            </div>
                            
                            <!-- GitHub Link with star count -->
                            <div>
                                <Link href="https://github.com/RAHIMSTUDIOS/nextpy-framework" target="_blank" rel="noopener noreferrer" className="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium transition-colors duration-200 rounded-full border border-zinc-800 bg-zinc-900/60 text-zinc-300 hover:text-white hover:border-zinc-700" aria-label="GitHub Repository">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                                    </svg>
                                    <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M11.049 2.926c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                    </svg>
                                    <span class="text-xs font-semibold tabular-nums">{star_count}</span>
                                </Link>
                            </div>
                        </div>

                        </div>
                    </header>

                    {/* Main Layout Grid Container */}
                    <div class="flex-1 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
                        {/* REMOVED items-start so the sidebar stretches to full height */}
                        <div class="flex justify-between gap-2">
                            
                            {/* 1. Left Sidebar Navigation Area (Fixed Width) */}
                            <aside class="hidden lg:block w-[280px] shrink-0">
                                <div class="sticky top-16 h-[calc(100vh-4rem)] py-12 pr-12 overflow-y-auto scrollbar-none">
                                    <EnhancedSidebar />
                                </div>
                            </aside>

                            {/* 2. Main Content Area (Children handle their own max-w constraints) */}
                            <main class="flex min-w-0 py-6">
                                {children}
                            </main>

                        </div>
                    </div>
                </div>
            </body>
        </html>
    )