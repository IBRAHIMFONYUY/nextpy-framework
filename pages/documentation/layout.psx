from nextpy.psx import component, register_component, Link
from pages.documentation.components.enhanced_sidebar import EnhancedSidebar

register_component("EnhancedSidebar", EnhancedSidebar)

@component
def Layout(children, **props):
    return (
        <html>
            <head>
                <title>{props.get('title', 'NextPy Docs- The Python Web Framework')}</title>
                <link rel="shortcut icon" href="/static/images/icon.png" type="image/x-icon" />
                <link href="/static/styles.css" rel="stylesheet" />
                <link href="/tailwind.css" rel="stylesheet" />
            </head>
            <body class="bg-[#000000] text-[#eddde3] antialiased selection:bg-blue-500/30 selection:text-blue-200">
                <div class="min-h-screen flex flex-col scroll-smooth w-full">
                    
                    {/* Modern Top Header / Navbar */}
                    <header class="sticky top-0 z-50 w-full border-b border-zinc-800/50 bg-black/70 backdrop-blur-md">
                        <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-4 sm:px-6 lg:px-8">
                            <div class="flex items-center gap-8">
                                <Link href="/" class="flex items-center gap-2 font-bold tracking-tight text-white hover:opacity-90">
                                    <span class="bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent text-lg">Next.py</span>
                                    <span class="text-xs font-medium px-2 py-0.5 rounded border border-zinc-800 bg-zinc-900 text-zinc-400">Docs</span>
                                </Link>
                                <nav class="hidden md:flex items-center gap-6 text-[15px] font-medium text-zinc-400">
                                    <Link href="/docs" class="text-white">Documentation</Link>
                                    <Link href="/showcase" class="hover:text-zinc-200 transition-colors">Showcase</Link>
                                    <Link href="/blog" class="hover:text-zinc-200 transition-colors">Blog</Link>
                                </nav>
                            </div>
                            
                            <div class="flex items-center gap-4">
                                <div class="relative hidden sm:block w-56 md:w-72">
                                    <div class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-zinc-500">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                                    </div>
                                    <input type="text" placeholder="Search docs..." disabled class="w-full rounded-md border border-zinc-800 bg-zinc-900/50 py-2 pl-10 pr-4 text-sm text-zinc-400 placeholder-zinc-500 focus:outline-none cursor-not-allowed" />
                                    <div class="absolute inset-y-0 right-3 flex items-center">
                                        <kbd class="rounded border border-zinc-700 bg-zinc-800 px-1.5 text-[11px] font-sans text-zinc-400">⌘K</kbd>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </header>

                    {/* Main Layout Grid Container */}
                    <div class="flex-1 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
                        {/* REMOVED items-start so the sidebar stretches to full height */}
                        <div class="flex justify-between gap-8">
                            
                            {/* 1. Left Sidebar Navigation Area (Fixed Width) */}
                            <aside class="hidden lg:block w-[280px] shrink-0 border-r border-zinc-800/50">
                                <div class="sticky top-16 h-[calc(100vh-4rem)] py-12 pr-6 overflow-y-auto scrollbar-none">
                                    <EnhancedSidebar />
                                </div>
                            </aside>

                            {/* 2. Main Content Area (Children handle their own max-w constraints) */}
                            <main class="flex-1 min-w-0 py-10">
                                {children}
                            </main>

                        </div>
                    </div>
                </div>
            </body>
        </html>
    )